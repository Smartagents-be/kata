<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <relativePath/>
  </parent>

  <groupId>be.smartagents</groupId>
  <artifactId>kata-agentic-java-step0</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>kata-agentic-java-step0</name>
  <description>Step 0: the intro. Test sources only - one reveal, run behind the `intro` profile.</description>

  <properties>
    <java.version>25</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <!--
      There is no production code in step 0. The intro's whole Java surface is one reveal test, so
      the only dependency is the test starter (JUnit and AssertJ, versions managed by the parent).
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <profiles>
    <!--
      The step 0 intro. Off by default, so `mvn verify` stays green on a clean checkout. Turn it on
      with `mvn verify -Pintro` and it runs IntroRevealIT, which prints the one flag that finishes
      the intro's second page. There is no gate here: running it is the whole exercise, a miniature
      of step 2's `graded` profile so the workflow is familiar before step 2 needs it.
    -->
    <profile>
      <id>intro</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <executions>
              <execution>
                <id>reveal-intro-flag</id>
                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
