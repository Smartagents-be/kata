{
  "name": "kata",
  "build": {
    "dockerfile": "Dockerfile",
    "args": { "CLAUDE_CODE_VERSION": "2.1.300", "COPILOT_VERSION": "1.0.98" }
  },
  // Runs on your laptop before every `up`: review.sh fails if the last session left files git does
  // not show. This file and the script are read-only inside the container, so the agent cannot
  // change either.
  "initializeCommand": ["${localWorkspaceFolder}/.devcontainer/review.sh"],
  "remoteUser": "node",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "workspaceFolder": "/workspace",
  "mounts": [
    // The agents' logins and settings survive a rebuild. With no keychain in here, Copilot CLI keeps
    // its token as plain text in its volume, the way Claude Code keeps its own in ~/.claude.
    "source=kata-claude-config-${devcontainerId},target=/home/node/.claude,type=volume",
    "source=kata-copilot-config-${devcontainerId},target=/home/node/.copilot,type=volume",
    // Maven's downloads survive a rebuild too, so the first `mvn verify` is the only slow one.
    "source=kata-m2-${devcontainerId},target=/home/node/.m2,type=volume",
    // Git history is read-only in here. You commit and push from your laptop anyway, and a
    // writable .git would let whatever runs in the container plant a hook that runs on your laptop.
    "source=${localWorkspaceFolder}/.git,target=/workspace/.git,type=bind,readonly",
    // Read-only in here too, because your laptop runs what is in them and git does not show all of
    // it. devcontainer.json decides what runs on your laptop at the next `up` (initializeCommand)
    // and what gets mounted. .claude/settings.local.json is git-ignored and Claude Code on your
    // laptop runs its hooks at start. .idea holds IntelliJ's run configurations, some of them
    // git-ignored. The agent in here cannot save "always allow" choices for the project as a result.
    "source=${localWorkspaceFolder}/.devcontainer,target=/workspace/.devcontainer,type=bind,readonly",
    "source=${localWorkspaceFolder}/.claude,target=/workspace/.claude,type=bind,readonly",
    "source=${localWorkspaceFolder}/.idea,target=/workspace/.idea,type=bind,readonly",
    // .impeccable's git-ignored files are read by the Impeccable tool on your laptop.
    "source=${localWorkspaceFolder}/.impeccable,target=/workspace/.impeccable,type=bind,readonly",
    // Builds in here write to volumes, not to the target/ folders on your laptop. Maven on your
    // laptop skips compiling when target/ is newer than the sources, so classes built in here would
    // otherwise run on your laptop unseen: target/ is git-ignored.
    "source=kata-target-step0-${devcontainerId},target=/workspace/exercises/step0/java/target,type=volume",
    "source=kata-target-step1-${devcontainerId},target=/workspace/exercises/step1/java/target,type=volume",
    "source=kata-target-step2-${devcontainerId},target=/workspace/exercises/step2/java/target,type=volume",
    "source=kata-target-step3-${devcontainerId},target=/workspace/exercises/step3/java/target,type=volume",
    // The same for the other git-ignored folders review.sh expects: what is written to them in here
    // stays in here. front/dist is served and shipped from your laptop; the other 3 are the
    // maintainer's scratch folders, read by agents on the laptop. On a laptop without them, Docker
    // leaves an empty folder where each one mounts, which git does not show.
    "source=kata-front-dist-${devcontainerId},target=/workspace/front/dist,type=volume",
    "source=kata-scratch-playwright-${devcontainerId},target=/workspace/.playwright-mcp,type=volume",
    "source=kata-scratch-shots-${devcontainerId},target=/workspace/.shots,type=volume",
    "source=kata-scratch-review-${devcontainerId},target=/workspace/review,type=volume",
    // The container's node_modules hold Linux binaries; a volume keeps them off the host's copy.
    "source=kata-node-modules-${devcontainerId},target=/workspace/front/node_modules,type=volume"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/node/.claude",
    "COPILOT_HOME": "/home/node/.copilot",
    // The versions that were rehearsed are the versions that run in class.
    "DISABLE_AUTOUPDATER": "1",
    "COPILOT_AUTO_UPDATE": "false"
  },
  // 5173 the frontend, 8080 step 1's service, 8082 step 2's. An IDE forwards these; the
  // devcontainer CLI does not.
  "forwardPorts": [5173, 8080, 8082],
  // So the frontend is also published, for the CLI route: open localhost:5174 on your laptop once
  // `npm run dev -- --host 0.0.0.0` runs in front/. 5174 rather than 5173 so it does not clash with a
  // Vite you run on the laptop itself, and on 127.0.0.1 so nothing outside your machine reaches it.
  // Vite proxies /api to the service inside the container, so the catalogue works through it too.
  "appPort": ["127.0.0.1:5174:5173"],
  "postCreateCommand": "npm ci --prefix front"
}
